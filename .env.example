# Любой OpenAI-совместимый API с поддержкой вызова инструментов (tools).

# Ollama локально (бесплатно, без ключа):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Yandex AI Studio:
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_API_KEY=<API-ключ сервисного аккаунта>
# LLM_PROJECT=<ID каталога>
# LLM_MODEL=gpt://<ID каталога>/yandexgpt/latest

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Адрес MCP-сервера почты (вариант 4)
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Права «только чтение»: запросы на изменение данных отклоняются до цикла агента
# AGENT_READ_ONLY=1
