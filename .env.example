# OpenAI-совместимый API (OpenAI, Ollama, LM Studio, vLLM, OpenRouter...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Ollama локально:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Адрес MCP-сервера почты (вариант 4)
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Права «только чтение»: запросы на изменение данных отклоняются до цикла агента
# AGENT_READ_ONLY=1
